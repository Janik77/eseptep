# Local-only defaults. Never commit .env or actual secrets.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY=generate-locally-for-production
# DJANGO_DB_PATH=/absolute/path/to/test.sqlite3
# DJANGO_PRIVATE_MEDIA_ROOT=/absolute/non-public/path
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain
DJANGO_TRUST_PROXY=false
# Anonymized local plan pilot. Keep disabled until a server key is securely configured.
PLAN_AI_ENABLED=0
OPENAI_API_KEY=

# Paste the existing eseptep-ai-production key only into ignored .env, never here.
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_MAX_OUTPUT_TOKENS=1800
OPENAI_TIMEOUT_SECONDS=45
OPENAI_LIVE_CONFIRMED=0
ESTIMATE_AI_ENABLED=0
