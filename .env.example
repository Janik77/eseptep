# Local-only defaults. Never commit .env or actual secrets.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY=generate-locally-for-production
# DJANGO_DB_PATH=/absolute/path/to/test.sqlite3
# DJANGO_PRIVATE_MEDIA_ROOT=/absolute/non-public/path
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain
DJANGO_TRUST_PROXY=false
