# Copy manually to /etc/eseptep-pilot/app.env (root-owned, mode 0600).
# Fill a unique secret locally; do not commit or paste it into chat.
DJANGO_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=PILOT_HOSTNAME_REPLACE_ME
DJANGO_CSRF_TRUSTED_ORIGINS=https://PILOT_HOSTNAME_REPLACE_ME
DJANGO_TRUST_PROXY=true
DJANGO_DB_PATH=/var/lib/eseptep-pilot/demo.sqlite3
DJANGO_PRIVATE_MEDIA_ROOT=/var/lib/eseptep-pilot/private
ESEPTEP_CLOSED_PILOT=1
ESEPTEP_DEMO_MODE=0
ESEPTEP_CONTRACT_DEMO_ENABLED=1
ESEPTEP_PILOT_SUPPLIER_USERNAME=
PLAN_AI_ENABLED=0
ESEPTEP_CONTRACT_AI_ENABLED=0
ESEPTEP_CONTRACT_OFFLINE_MOCK=0
ESTIMATE_AI_ENABLED=0
OPENAI_LIVE_CONFIRMED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_MAX_OUTPUT_TOKENS=1800
OPENAI_TIMEOUT_SECONDS=55
LOCAL_AI_BUDGET_PATH=/var/lib/eseptep-pilot/local-ai-budget.sqlite3
